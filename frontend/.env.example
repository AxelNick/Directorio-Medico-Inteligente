# Producción en Vercel: crear VITE_API_BASE_URL en Settings → Environment Variables.
# Vite incorpora esta URL pública durante el build; jamás poner claves de Supabase aquí.
VITE_API_BASE_URL=https://tu-servicio.onrender.com

# Desarrollo local opcional: Vite reenvía /api al backend remoto sin CORS en el navegador.
# Poner estas dos variables en .env.local y omitir VITE_API_BASE_URL en desarrollo.
# VITE_DATA_SOURCE=api
# VITE_DEV_API_TARGET=https://tu-servicio.onrender.com
