# Ejemplo para docker run --env-file backend/.env (valores reales solo en .env ignorado).
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<password-de-la-base>
JWT_SECRET=<secreto-aleatorio-de-al-menos-32-caracteres>
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Administrador propio opcional en el primer arranque.
APP_ADMIN_BOOTSTRAP_USERNAME=
APP_ADMIN_BOOTSTRAP_PASSWORD=
# El modo simulado usa catálogo local y no llama a terceros.
APP_TRIAGE_PROVIDER=simulado
APP_TRIAGE_OPENAI_KEY=
APP_TRIAGE_OPENAI_MODEL=
# Si se omite la URL, se usa APP_UPLOADS_DIR en disco.
APP_UPLOADS_SUPABASE_URL=
APP_UPLOADS_SUPABASE_BUCKET=fotos-medicos
APP_UPLOADS_SUPABASE_KEY=
